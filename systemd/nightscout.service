# Nightscout Systemd Service
#
# This service runs Nightscout via Docker Compose.
#
# Installation:
#   sudo cp nightscout.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable nightscout
#   sudo systemctl start nightscout
#
# Management:
#   sudo systemctl status nightscout
#   sudo systemctl stop nightscout
#   sudo systemctl restart nightscout
#   journalctl -u nightscout -f
#

[Unit]
Description=Nightscout CGM Remote Monitor
Documentation=https://nightscout.github.io/
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes

# UPDATE: Set the path to your diabetes repo
WorkingDirectory=/home/YOUR_USERNAME/diabetes/config

# Start containers
ExecStart=/usr/bin/docker compose up -d

# Stop containers
ExecStop=/usr/bin/docker compose down

# Restart policy
Restart=on-failure
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
