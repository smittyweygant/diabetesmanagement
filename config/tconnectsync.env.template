# Tconnectsync Environment Configuration
# Copy this file to tconnectsync.env and fill in your values
# Documentation: https://github.com/jwoglom/tconnectsync

# =============================================================================
# TANDEM SOURCE CREDENTIALS
# =============================================================================

# Your Tandem Source (t:connect) login email
TCONNECT_EMAIL=your-email@example.com

# Your Tandem Source password
TCONNECT_PASSWORD=your-password-here

# Region: US or EU
TCONNECT_REGION=US

# =============================================================================
# NIGHTSCOUT CONNECTION
# =============================================================================

# URL of your Nightscout instance
NS_URL=https://your-nightscout-url.com

# Nightscout API secret (must match API_SECRET in nightscout.env)
NS_SECRET=CHANGE_ME_MIN_12_CHARS

# =============================================================================
# PUMP SETTINGS
# =============================================================================

# Timezone of your pump (TZ database name)
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE_NAME=America/New_York

# Your pump's serial number (optional - will auto-detect most recent pump if not set)
# PUMP_SERIAL_NUMBER=11111111

# =============================================================================
# SYNC FEATURES
# =============================================================================

# Features to sync (space-delimited)
# Available: BASAL, BOLUS, PUMP_EVENTS, PROFILES, CGM
# Default: BASAL BOLUS PUMP_EVENTS PROFILES
# Note: CGM has >30 min lag - only use if no other CGM uploader
TCONNECTSYNC_FEATURES=BASAL BOLUS PUMP_EVENTS PROFILES

# =============================================================================
# OPTIONAL SETTINGS
# =============================================================================

# Log level for debugging
# TCONNECTSYNC_DEBUG=false

# Number of days to look back for initial sync
# TCONNECTSYNC_DAYS=1
