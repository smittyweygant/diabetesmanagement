# tconnectsync configuration - REFERENCE TEMPLATE
# ---------------------------------------------------------------------------
# Real values live ENCRYPTED in secrets/tconnectsync.env.sops.yaml and are
# decrypted to ${SECRETS_DIR}/tconnectsync.env (tmpfs) at service start.
# See secrets/README.md.
#
# tconnectsync >= 2.0 is required (Tandem retired t:connect for Tandem Source
# in Sept 2024). The ghcr.io/jwoglom/tconnectsync image is current.
# Docs: https://github.com/jwoglom/tconnectsync
# ---------------------------------------------------------------------------

# ===== Tandem Source credentials =====
TCONNECT_EMAIL=you@example.com
TCONNECT_PASSWORD=CHANGE_ME
TCONNECT_REGION=US                 # US or EU

# ===== pump =====
# Tandem Mobi serial - find it in the Tandem mobile app or on tandemsource.com.
PUMP_SERIAL_NUMBER=00000000
TIMEZONE_NAME=America/Denver       # keep identical to Nightscout TZ

# ===== Nightscout target =====
# Container-to-container over the compose network - NOT the Tailscale name.
# Works even when `tailscale serve` is down, and avoids NAT hairpin.
NS_URL=http://nightscout:1337
NS_SECRET=CHANGE_ME_MIN_12_CHARS   # the PLAINTEXT Nightscout API_SECRET; tconnectsync hashes it itself

# ===== notes =====
# Sync features are passed on the command line in docker-compose.yml:
#   --auto-update --features BASAL BOLUS PUMP_EVENTS PROFILES CGM
# There is no reliable TCONNECTSYNC_FEATURES env var across versions.
# First run may require interactive OAuth + 2FA:
#   docker compose run --rm -it tconnectsync --check-login
# The token is cached in the mounted volume (TCONNECTSYNC_DATA_DIR).

# ===== optional =====
# AUTOUPDATE_DEFAULT_SLEEP_SECONDS=300
# TCONNECTSYNC_DEBUG=false
