# MongoDB backup configuration - REFERENCE TEMPLATE
# ---------------------------------------------------------------------------
# If you use S3 offsite backups, the real values (including AWS keys) live
# ENCRYPTED in secrets/backup.env.sops.yaml and are decrypted to
# ${SECRETS_DIR}/backup.env at service start. Local-only backups need nothing here.
# See secrets/README.md.
# ---------------------------------------------------------------------------

# ===== MongoDB (only used when NOT running with --docker) =====
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=nightscout

# ===== AWS S3 offsite (optional) =====
# Use a dedicated IAM user scoped to just this bucket.
S3_BUCKET=your-bucket-name
S3_PREFIX=beelink
# AWS_DEFAULT_REGION=us-west-2
# AWS_ACCESS_KEY_ID=CHANGE_ME
# AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ===== retention =====
# Number of backups to keep in S3 (older ones removed with --cleanup).
BACKUP_RETENTION=30
