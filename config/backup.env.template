# MongoDB Backup Configuration
# Copy this file to backup.env and fill in your values

# =============================================================================
# MONGODB CONNECTION
# =============================================================================

# MongoDB host (use 'localhost' for Docker, or container name if in same network)
MONGO_HOST=localhost

# MongoDB port
MONGO_PORT=27017

# Database name
MONGO_DB=nightscout

# =============================================================================
# AWS S3 CONFIGURATION
# =============================================================================

# S3 bucket name for storing backups
S3_BUCKET=your-bucket-name

# S3 prefix/folder for backups
S3_PREFIX=nightscout-backups

# AWS region (if not set in AWS CLI config)
# AWS_DEFAULT_REGION=us-east-1

# =============================================================================
# RETENTION POLICY
# =============================================================================

# Number of backups to keep in S3 (older ones deleted with --cleanup)
BACKUP_RETENTION=30
