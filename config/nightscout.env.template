# Nightscout configuration - REFERENCE TEMPLATE
# ---------------------------------------------------------------------------
# Do NOT fill this in and rename it to nightscout.env. The real values live
# ENCRYPTED in secrets/nightscout.env.sops.yaml and are decrypted to
# ${SECRETS_DIR}/nightscout.env (tmpfs) at service start. See secrets/README.md.
#
# This file just documents every variable the stack expects.
# Docs: https://nightscout.github.io/nightscout/setup_variables/
# ---------------------------------------------------------------------------

# ===== core =====
# MONGO_CONNECTION is injected by docker-compose.yml (mongodb://mongo:27017/nightscout)
API_SECRET=CHANGE_ME_MIN_12_CHARS          # openssl rand -hex 20
NODE_ENV=production
TZ=America/Denver                          # set to your home-base tz; keep identical in tconnectsync
INSECURE_USE_HTTP=true                     # TLS terminates at Tailscale Serve
SECURE_HSTS_HEADER=false

# ===== access (Tailscale-only, auth ON) =====
AUTH_DEFAULT_ROLES=denied                  # token required even to view; use 'readable' for lower friction
BASE_URL=https://beelink-ns.YOUR-TAILNET.ts.net
# plain-HTTP variant instead of Tailscale Serve:
# BASE_URL=http://beelink-ns.YOUR-TAILNET.ts.net:1337

# ===== display =====
DISPLAY_UNITS=mg/dl
TIME_FORMAT=12
THEME=colors
NIGHT_MODE=off
CUSTOM_TITLE=Nightscout-Smitty
LANGUAGE=en

# ===== CGM: Dexcom G7 via Dexcom Share (real-time feed) =====
CONNECT_SOURCE=dexcomshare
CONNECT_SHARE_ACCOUNT_NAME=you@example.com   # MUST NOT be a phone number; needs an active follower
CONNECT_SHARE_PASSWORD=CHANGE_ME
BRIDGE_SERVER=US

# ===== pump / loop rendering (Tandem Mobi) =====
DEVICESTATUS_ADVANCED=true
PUMP_FIELDS=reservoir battery clock
SHOW_FORECAST=openaps loop
SHOW_PLUGINS=careportal dbsize iob cob sage cage iage pump basal

# ===== plugins =====
# Use `connect` (nightscout-connect) only. Do NOT add the deprecated `bridge` plugin -
# running both produces a duplicate Dexcom Share feed.
ENABLE=careportal basal dbsize iob cob bwp cage iage sage bage boluscalc treatmentnotify pump profile food openaps loop override cors connect

# ===== alarms =====
ALARM_TYPES=simple
BG_HIGH=260
BG_TARGET_TOP=180
BG_TARGET_BOTTOM=70
BG_LOW=55
ALARM_URGENT_HIGH=on
ALARM_HIGH=on
ALARM_LOW=on
ALARM_URGENT_LOW=on
ALARM_TIMEAGO_WARN=on
ALARM_TIMEAGO_WARN_MINS=15
ALARM_TIMEAGO_URGENT=on
ALARM_TIMEAGO_URGENT_MINS=30
HEARTBEAT=60

# ===== optional integrations (add tokens later for phone alerts) =====
# ENABLE += ' pushover maker'
# PUSHOVER_API_TOKEN=
# PUSHOVER_USER_KEY=
# MAKER_KEY=
