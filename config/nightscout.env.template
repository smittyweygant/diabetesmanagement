# Nightscout Environment Configuration
# Copy this file to nightscout.env and fill in your values
# Documentation: https://nightscout.github.io/nightscout/setup_variables/

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# MongoDB connection string
# For local Docker setup: mongodb://mongo:27017/nightscout
# For external MongoDB: mongodb://user:password@host:port/database
MONGO_CONNECTION=mongodb://mongo:27017/nightscout

# API Secret - must be at least 12 characters
# Used to authenticate admin access and API calls
API_SECRET=CHANGE_ME_MIN_12_CHARS

# =============================================================================
# DISPLAY SETTINGS
# =============================================================================

# Display units: mg/dl or mmol/L
DISPLAY_UNITS=mg/dl

# Timezone (TZ database name)
# https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York

# Site title shown in browser
CUSTOM_TITLE=Nightscout

# Theme: default, colors, or colorblindfriendly
THEME=colors

# Time format: 12 or 24
TIME_FORMAT=12

# Language code (en, es, de, fr, etc.)
LANGUAGE=en

# =============================================================================
# FEATURES & PLUGINS
# =============================================================================

# Enable optional features (space-delimited list)
# Common plugins: careportal rawbg iob cob bwp cage sage iage bage pump openaps loop
ENABLE=careportal rawbg iob cob bwp cage sage iage bage treatmentnotify basal bolus pump

# Disable default features (space-delimited)
# DISABLE=

# Authentication default roles: readable, denied, or status-only
# readable = anyone can view without token
# denied = token required for all access
AUTH_DEFAULT_ROLES=denied

# Base URL of your Nightscout site (for callbacks/links)
# BASE_URL=https://your-nightscout-url.com

# =============================================================================
# ALARM SETTINGS
# =============================================================================

# Alarm types: simple, predict, or both (space-delimited)
ALARM_TYPES=predict

# BG thresholds (in your DISPLAY_UNITS)
BG_HIGH=260
BG_TARGET_TOP=180
BG_TARGET_BOTTOM=80
BG_LOW=55

# Enable/disable specific alarms: on or off
ALARM_URGENT_HIGH=on
ALARM_HIGH=on
ALARM_LOW=on
ALARM_URGENT_LOW=on

# Snooze times in minutes (space-delimited options)
ALARM_URGENT_HIGH_MINS=30 60 90 120
ALARM_HIGH_MINS=30 60 90 120
ALARM_LOW_MINS=15 30 45 60
ALARM_URGENT_LOW_MINS=15 30 45

# Time ago alarms
ALARM_TIMEAGO_WARN=on
ALARM_TIMEAGO_WARN_MINS=15
ALARM_TIMEAGO_URGENT=on
ALARM_TIMEAGO_URGENT_MINS=30

# =============================================================================
# ADVANCED SETTINGS
# =============================================================================

# Node environment
NODE_ENV=production

# Port (default 1337, typically proxied behind nginx/traefik)
# PORT=1337

# Allow HTTP (set to true if using reverse proxy for SSL)
INSECURE_USE_HTTP=true

# Database heartbeat interval in seconds
HEARTBEAT=60

# =============================================================================
# OPTIONAL INTEGRATIONS
# =============================================================================

# Pushover notifications
# PUSHOVER_API_TOKEN=
# PUSHOVER_USER_KEY=

# IFTTT Maker webhooks
# MAKER_KEY=
# MAKER_ANNOUNCEMENT_KEY=
