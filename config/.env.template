# Non-secret Docker Compose interpolation values.
# Copy to config/.env on the host:  cp config/.env.template config/.env
# config/.env is gitignored. It contains NO secrets - real config is in secrets/*.sops.yaml.

# Directory the decrypted *.env files are written to at service start.
# systemd/diabetes-stack.service decrypts into a tmpfs here. For a manual/dev
# bring-up, point this somewhere you decrypted the files yourself.
SECRETS_DIR=/run/diabetes

# MongoDB data volume (bind mount). Absolute path on the host recommended.
MONGO_DATA_DIR=/opt/diabetes/data/mongo

# tconnectsync credential/token cache volume.
TCONNECTSYNC_DATA_DIR=/opt/diabetes/data/tconnectsync

# Caddy certificate/ACME state.
CADDY_DATA_DIR=/opt/diabetes/data/caddy
