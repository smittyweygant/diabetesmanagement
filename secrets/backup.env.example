# Plaintext placeholder for secrets/backup.env.sops.yaml
# Only needed for S3 offsite backups. Local backups need none of this.
# Encrypt it, then edit in real values:  sudo -E scripts/secrets.sh edit backup

MONGO_DB=nightscout

S3_BUCKET=your-bucket-name
S3_PREFIX=beelink
AWS_DEFAULT_REGION=us-west-2
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME

BACKUP_RETENTION=30
