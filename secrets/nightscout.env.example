# Plaintext placeholder for secrets/nightscout.env.sops.yaml
# Encrypt it, then edit in real values:  sudo -E scripts/secrets.sh edit nightscout
# Full documentation of every var: ../config/nightscout.env.template

API_SECRET=REPLACE_WITH_openssl_rand_hex_20
NODE_ENV=production
TZ=America/Denver
INSECURE_USE_HTTP=true
SECURE_HSTS_HEADER=false

AUTH_DEFAULT_ROLES=denied
BASE_URL=https://beelink-ns.YOUR-TAILNET.ts.net

DISPLAY_UNITS=mg/dl
TIME_FORMAT=12
THEME=colors
NIGHT_MODE=off
CUSTOM_TITLE=Nightscout-Smitty
LANGUAGE=en

CONNECT_SOURCE=dexcomshare
CONNECT_SHARE_ACCOUNT_NAME=you@example.com
CONNECT_SHARE_PASSWORD=REPLACE_ME
BRIDGE_SERVER=US

DEVICESTATUS_ADVANCED=true
PUMP_FIELDS=reservoir battery clock
SHOW_FORECAST=openaps loop
SHOW_PLUGINS=careportal dbsize iob cob sage cage iage pump basal

ENABLE=careportal basal dbsize iob cob bwp cage iage sage bage boluscalc treatmentnotify pump profile food openaps loop override cors connect

ALARM_TYPES=simple
BG_HIGH=260
BG_TARGET_TOP=180
BG_TARGET_BOTTOM=70
BG_LOW=55
ALARM_URGENT_HIGH=on
ALARM_HIGH=on
ALARM_LOW=on
ALARM_URGENT_LOW=on
ALARM_TIMEAGO_WARN=on
ALARM_TIMEAGO_WARN_MINS=15
ALARM_TIMEAGO_URGENT=on
ALARM_TIMEAGO_URGENT_MINS=30
HEARTBEAT=60
