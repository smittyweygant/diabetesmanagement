# Cloned upstream repositories (no longer used - stack runs from images - kept for safety)
cgm-remote-monitor/
tconnectsync/

# Plaintext environment files - NEVER commit. Real config lives in secrets/*.sops.yaml (encrypted).
*.env
!*.env.template
!*.env.example
*.env.backup

# Decrypted secrets land here at runtime (tmpfs on the host); never on disk in the repo
/run/
secrets/*.env
secrets/plaintext/

# age / SOPS private keys - the one bootstrap secret, host-only
*.agekey
*age*key*.txt
keys.txt
key.txt

# History-redaction helper (local only, may contain leaked literals)
scripts/redactions.txt

# Compose interpolation values (no secrets, but host-specific)
config/.env

# Container data volumes
data/
mongo-data/

# Let's Encrypt (unused with Tailscale, kept ignored for old checkouts)
letsencrypt/

# Captured remote host config - contains real secrets, never commit
remote-config/

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/

# Node.js
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
logs/

# Backup files (local copies before upload)
backups/
